{
  "name": "woodgate-mock",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src test vitest.config.ts",
    "lint:fix": "oxlint --fix src test vitest.config.ts",
    "test": "vitest run",
    "types": "wrangler types --include-runtime false",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261108.1",
    "oxlint": "1.92.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "packageManager": "pnpm@12.18.0"
}
