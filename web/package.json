{
  "name": "woodgate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && touch dist/.gitkeep",
    "preview": "vite preview",
    "lint": "oxlint . && tsc -b",
    "lint:fix": "oxlint --fix . && tsc -b",
    "typecheck": "tsc -b",
    "format": "oxfmt",
    "openapi:types": "openapi-typescript ../api/openapi.yaml -o src/api/openapi.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/utils": "^9.2.0",
    "openapi-fetch": "^0.17.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-admin": "^5.15.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "openapi-typescript": "^7.13.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "~6.0.3",
    "vite": "^8.2.0"
  },
  "packageManager": "pnpm@11.20.0"
}
